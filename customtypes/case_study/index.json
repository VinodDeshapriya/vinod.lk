{
  "id": "case_study",
  "label": "Case Study",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": "absoliq"
        }
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Project name",
          "placeholder": "Absoliq"
        }
      },
      "summary": {
        "type": "Text",
        "config": {
          "label": "Card summary",
          "placeholder": ""
        }
      },
      "category": {
        "type": "Text",
        "config": {
          "label": "Category",
          "placeholder": "Websites"
        }
      },
      "status": {
        "type": "Select",
        "config": {
          "label": "Status",
          "options": [
            "Live",
            "Design complete"
          ],
          "default_value": "Live"
        }
      },
      "live_url": {
        "type": "Link",
        "config": {
          "label": "Live site",
          "select": null,
          "allowTargetBlank": true,
          "allowText": false,
          "repeat": false
        }
      },
      "thumbnail": {
        "type": "Image",
        "config": {
          "label": "Card thumbnail",
          "constraint": {},
          "thumbnails": []
        }
      },
      "order": {
        "type": "Number",
        "config": {
          "label": "Order on the Work page (1 = first)",
          "placeholder": "1"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "case_hero": {
              "type": "SharedSlice"
            },
            "case_facts": {
              "type": "SharedSlice"
            },
            "case_about": {
              "type": "SharedSlice"
            },
            "case_challenge": {
              "type": "SharedSlice"
            },
            "case_approach": {
              "type": "SharedSlice"
            },
            "case_device_viewer": {
              "type": "SharedSlice"
            },
            "case_highlights": {
              "type": "SharedSlice"
            },
            "case_built": {
              "type": "SharedSlice"
            },
            "work_grid": {
              "type": "SharedSlice"
            },
            "call_to_action": {
              "type": "SharedSlice"
            },
            "rich_text": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta title",
          "placeholder": ""
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta description",
          "placeholder": ""
        }
      },
      "meta_keywords": {
        "type": "Text",
        "config": {
          "label": "Keywords (comma-separated)",
          "placeholder": ""
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta image",
          "constraint": {},
          "thumbnails": []
        }
      }
    }
  }
}
