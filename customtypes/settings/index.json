{
  "id": "settings",
  "label": "Settings",
  "format": "custom",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "site_name": {
        "type": "Text",
        "config": {
          "label": "Site name",
          "placeholder": ""
        }
      },
      "header_cta": {
        "type": "Link",
        "config": {
          "label": "Header button",
          "select": null,
          "allowText": true,
          "allowTargetBlank": true,
          "repeat": false
        }
      },
      "phone_numbers": {
        "type": "Group",
        "config": {
          "label": "Phone numbers",
          "repeat": true,
          "fields": {
            "number": {
              "type": "Text",
              "config": {
                "label": "Number",
                "placeholder": ""
              }
            }
          }
        }
      },
      "email": {
        "type": "Text",
        "config": {
          "label": "Email",
          "placeholder": ""
        }
      },
      "location": {
        "type": "Text",
        "config": {
          "label": "Location",
          "placeholder": ""
        }
      },
      "whatsapp_number": {
        "type": "Text",
        "config": {
          "label": "WhatsApp number (digits only)",
          "placeholder": ""
        }
      }
    },
    "Footer": {
      "footer_description": {
        "type": "Text",
        "config": {
          "label": "Footer description",
          "placeholder": ""
        }
      },
      "footer_strap": {
        "type": "Text",
        "config": {
          "label": "Footer strap text",
          "placeholder": ""
        }
      },
      "footer_cta": {
        "type": "Link",
        "config": {
          "label": "Footer strap button",
          "select": null,
          "allowText": true,
          "allowTargetBlank": true,
          "repeat": false
        }
      },
      "social_links": {
        "type": "Group",
        "config": {
          "label": "Social links",
          "repeat": true,
          "fields": {
            "platform": {
              "type": "Select",
              "config": {
                "label": "Platform",
                "options": [
                  "Facebook",
                  "Instagram",
                  "LinkedIn",
                  "TikTok",
                  "YouTube"
                ],
                "default_value": "Facebook"
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "Link",
                "select": null,
                "allowText": true,
                "allowTargetBlank": true,
                "repeat": false
              }
            }
          }
        }
      },
      "legal_links": {
        "type": "Group",
        "config": {
          "label": "Legal links",
          "repeat": true,
          "fields": {
            "link": {
              "type": "Link",
              "config": {
                "label": "Link",
                "select": null,
                "allowText": true,
                "allowTargetBlank": true,
                "repeat": false
              }
            }
          }
        }
      }
    },
    "Google": {
      "google_rating": {
        "type": "Text",
        "config": {
          "label": "Rating",
          "placeholder": "5.0"
        }
      },
      "google_review_count": {
        "type": "Number",
        "config": {
          "label": "Review count",
          "placeholder": ""
        }
      },
      "google_review_link": {
        "type": "Link",
        "config": {
          "label": "Review us link",
          "select": null,
          "allowText": true,
          "allowTargetBlank": true,
          "repeat": false
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta title",
          "placeholder": ""
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta description",
          "placeholder": ""
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta image",
          "constraint": {},
          "thumbnails": []
        }
      }
    },
    "Blog": {
      "author_name": {
        "type": "Text",
        "config": {
          "label": "Author name",
          "placeholder": "Vinod Deshapriya"
        }
      },
      "author_bio": {
        "type": "Text",
        "config": {
          "label": "Author bio",
          "placeholder": "UX engineer in Sri Lanka..."
        }
      },
      "author_photo": {
        "type": "Image",
        "config": {
          "label": "Author photo",
          "constraint": {
            "width": 96,
            "height": 96
          },
          "thumbnails": []
        }
      },
      "article_cta_eyebrow": {
        "type": "Text",
        "config": {
          "label": "Article sidebar CTA eyebrow",
          "placeholder": "Free 20-minute call"
        }
      },
      "article_cta_title": {
        "type": "StructuredText",
        "config": {
          "label": "Article sidebar CTA title",
          "allowTargetBlank": true,
          "single": "heading3,em"
        }
      },
      "article_cta_link": {
        "type": "Link",
        "config": {
          "label": "Article sidebar CTA link",
          "select": null,
          "allowText": true,
          "allowTargetBlank": true,
          "repeat": false
        }
      }
    }
  }
}
