{
  "id": "blog",
  "label": "Blog",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": ""
        }
      },
      "display_title": {
        "type": "StructuredText",
        "config": {
          "label": "Display title",
          "placeholder": "Optional. The title with highlighted (italic) words for the article page",
          "allowTargetBlank": true,
          "single": "heading1,em"
        }
      },
      "cover_title": {
        "type": "Text",
        "config": {
          "label": "Cover title",
          "placeholder": "Optional shorter title for the navy cover, e.g. UX vs UI: What's the Difference?"
        }
      },
      "tag": {
        "type": "Text",
        "config": {
          "label": "Tag",
          "placeholder": ""
        }
      },
      "excerpt": {
        "type": "Text",
        "config": {
          "label": "Excerpt",
          "placeholder": ""
        }
      },
      "cover_image": {
        "type": "Image",
        "config": {
          "label": "Cover image (optional, typographic cover used when empty)",
          "constraint": {},
          "thumbnails": []
        }
      },
      "publish_date": {
        "type": "Date",
        "config": {
          "label": "Publish date"
        }
      },
      "read_minutes": {
        "type": "Number",
        "config": {
          "label": "Read time (minutes)",
          "placeholder": ""
        }
      },
      "featured": {
        "type": "Boolean",
        "config": {
          "label": "Featured on the blog page",
          "default_value": false
        }
      },
      "related_service_title": {
        "type": "Text",
        "config": {
          "label": "Related service title",
          "placeholder": "Website Design"
        }
      },
      "related_service_text": {
        "type": "Text",
        "config": {
          "label": "Related service text",
          "placeholder": ""
        }
      },
      "related_service_link": {
        "type": "Link",
        "config": {
          "label": "Related service link",
          "select": null,
          "allowText": true,
          "allowTargetBlank": true,
          "repeat": false
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "rich_text": {
              "type": "SharedSlice"
            },
            "article_table": {
              "type": "SharedSlice"
            },
            "article_callout": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "call_to_action": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta title",
          "placeholder": ""
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta description",
          "placeholder": ""
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta image",
          "constraint": {},
          "thumbnails": []
        }
      }
    }
  }
}
